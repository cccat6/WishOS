  "fqbn": "esp32:esp32:esp32c6:CDCOnBoot=cdc,FlashSize=4M,PartitionScheme=huge_app,ZigbeeMode=zczr",
  "application_bytes": 3932160,
  "partition_file": "partitions.csv",
  "application_providers": [
    "user"
  ],
  "runtime_filesystem": {
    "format": "littlefs",
    "partition": "spiffs",
    "root": "/factory",
    "mount": "/storage/flash"
  },
