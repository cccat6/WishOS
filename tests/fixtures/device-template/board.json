{
  "format": "notes-board/1",
  "id": "fixture-device",
  "name": "Host configuration fixture",
  "mcu": "ESP32-C6FH4",
  "pins": {
    "KEY_A": 0,
    "KEY_B": 1,
    "KEY_C": 2,
    "BUSY": 3,
    "BATTERY": 4,
    "IMU_INT": 5,
    "SDA": 6,
    "SCL": 7,
    "DC": 8,
    "RESET": 9,
    "USB_DM": 12,
    "USB_DP": 13,
    "SHUTDOWN": 14,
    "MISO": 15,
    "SD_CS": 16,
    "MOSI": 17,
    "SCLK": 18,
    "PANEL_CS": 19,
    "PERIPHERAL_ENABLE": 20,
    "MIC_WS": 21,
    "MIC_DATA": 22,
    "MIC_BCLK": 23
